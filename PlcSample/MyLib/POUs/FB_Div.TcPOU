<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Div" Id="{e9566af9-57ca-45ca-9a98-13af705b0da9}" SpecialFunc="None">
    <Declaration><![CDATA[// Function block for calculating the division of two values
FUNCTION_BLOCK FB_Div
VAR_INPUT
	var1: UINT;    // variable 1
	var2: UINT;    // variable 2
END_VAR
VAR_OUTPUT
	result : UINT; // result
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Calculation of the division of two values
result := var1 / var2;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>