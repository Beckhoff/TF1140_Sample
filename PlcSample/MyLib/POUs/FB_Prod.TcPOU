<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Prod" Id="{00a1861b-3b8e-4d3a-95d3-7f3b2848d738}" SpecialFunc="None">
    <Declaration><![CDATA[// Function block for calculating the product of two values
FUNCTION_BLOCK FB_Prod
VAR_INPUT
	var1: UINT;    // variable 1
	var2: UINT;    // variable 2
END_VAR
VAR_OUTPUT
	result : UINT; // result
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Calculation of the product of two values
result := var1 * var2;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>