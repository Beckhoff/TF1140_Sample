<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Mod" Id="{25fcd21d-f201-41c3-a56a-87075d1743ec}" SpecialFunc="None">
    <Declaration><![CDATA[// Function block for calculating the modulo value of two variables
FUNCTION_BLOCK FB_Mod
VAR_INPUT
	var1: UINT;    // variable 1
	var2: UINT;    // variable 2
END_VAR
VAR_OUTPUT
	result : UINT; // result
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Calculation of the modulo value of two values
result := var1 Mod var2;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>